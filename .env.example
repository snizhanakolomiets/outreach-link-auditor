# Secrets stay only in your local .env. Never commit them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_BASE_LABEL=
AIRTABLE_TABLE_NAME=
AIRTABLE_TABLE_LABEL=
AIRTABLE_VIEW_NAME=
AIRTABLE_VIEW_LABEL=
AIRTABLE_WRITE_RESULTS=false
AIRTABLE_VALIDATE_SCHEMA=true

PROMPT_VERSION=v2
MAX_AI_CALLS=50
MAX_OUTPUT_TOKENS=3000
PREVIEW_LIMIT=5
CACHE_PATH=cache/audit_cache.sqlite3
SYSTEM_PROMPT_PATH=prompts/system_prompt.txt
PROJECT_PROFILES_PATH=config/project_profiles.json
AIRTABLE_FIELDS_PATH=config/airtable_fields.json
LOG_LEVEL=INFO
DO_NOT_CONTACT_DOMAINS=
DUPLICATE_MODE=placement
LINK_CHECK_TIMEOUT_SECONDS=15
MAX_PAGE_BYTES=2500000
USER_AGENT=AI-Outreach-Link-Auditor/1.0
BROWSER_FALLBACK_ENABLED=true
BROWSER_FALLBACK_TIMEOUT_SECONDS=25
# Optional absolute path. Leave empty to use the installed Google Chrome.
BROWSER_EXECUTABLE=

# Decision and relevance thresholds (0-100; confidence is 0-1).
REJECT_SCORE_BELOW=40
ACCEPT_SCORE_AT_LEAST=80
MIN_ACCEPT_CONFIDENCE=0.7
WEAK_MIN_SCORE=40
RELEVANT_WITH_LIMITATIONS_MIN_SCORE=60
RELEVANT_MIN_SCORE=80
